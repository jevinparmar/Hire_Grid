# SERVER CONFIGURATION
PORT=5000
NODE_ENV=production

# DATABASE CONFIGURATION (Neon PostgreSQL on Render)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# LOCAL DATABASE FALLBACK (if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiregrid
DB_USER=postgres
DB_PASSWORD=your_db_password

# AUTHENTICATION
JWT_SECRET=your_long_random_secure_jwt_secret_key_here
JWT_EXPIRE=7d

# EMAIL CONFIGURATION (Gmail App Password)
EMAIL_USER=your_email_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# CORS (frontend URL for production)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# ADMIN SEED (Super Admin created on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_immediately
ADMIN_NAME=Admin
